# ---- server/.env (انسخه إلى server/.env) ----
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/yunfamily?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# اختياري
TELEGRAM_BOT_TOKEN=
TZ=Asia/Amman
# إيميلات استعادة كلمة السر (جيميل + App Password من https://myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# عنوان الواجهة الذي تُبنى عليه روابط الإيميل (افتراضياً أول قيمة بـ CLIENT_ORIGIN)
APP_URL=https://yuncrochet-jo.onrender.com
# الذكاء الاصطناعي (Claude) — المفتاح من https://platform.claude.com/settings/keys
# بدونه التطبيق يشتغل بالطريقة البسيطة. لا تحطه بأي ملف مرفوع على GitHub.
ANTHROPIC_API_KEY=
# سقف حماية: أقصى عدد طلبات AI باليوم
AI_DAILY_LIMIT=300
# اختياري: موديل آخر (الافتراضي claude-opus-5-5)
AI_MODEL=
